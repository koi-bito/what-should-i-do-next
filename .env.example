# ============================================================
# WHAT SHOULD I DO NEXT? — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# ── DATABASE ──────────────────────────────────────────────
# Supabase Postgres connection string
DATABASE_URL=postgres://user:password@host:5432/postgres

# ── SUPABASE ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── REDIS (Upstash or local) ──────────────────────────────
# Local: redis://localhost:6379
# Upstash: rediss://default:password@host:6379
REDIS_URL=redis://localhost:6379

# ── AI / LLM ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api...
# Optional fallback LLM provider
# OPENAI_API_KEY=sk-...

# ── STRIPE ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAM=price_...

# ── EMAIL (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_...

# ── PUSH NOTIFICATIONS (OneSignal, v2 feature) ────────────
# ONESIGNAL_APP_ID=
# ONESIGNAL_API_KEY=

# ── GOOGLE OAuth (Sign-in + Calendar) ─────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── INTEGRATIONS (optional) ───────────────────────────────
# TODOIST_CLIENT_ID=
# TODOIST_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# TICKTICK_CLIENT_ID=
# TICKTICK_CLIENT_SECRET=

# ── SECURITY ──────────────────────────────────────────────
# AES-256 key for encrypting stored OAuth tokens (32-byte base64)
TOKEN_ENCRYPTION_KEY=base64encodedkey=

# ── APP CONFIG ────────────────────────────────────────────
# CORS allowed origins (comma-separated)
WEB_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
PORT=8080
NODE_ENV=development

# ── FRONTEND (Next.js public vars) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── MONITORING ─────────────────────────────────────────────
SENTRY_DSN=https://your-dsn@sentry.io/project
# AXIOM_TOKEN=
# AXIOM_DATASET=

# ── ANALYTICS ─────────────────────────────────────────────
POSTHOG_KEY=phc_...
